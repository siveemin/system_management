// ============================================================
//  SMART INVENTORY — DATABASE SCHEMA
//  Database: SQLite (dev)
//  ORM:      Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"

}

// ============================================================
//  PEOPLE & PLACES
// ============================================================

// role: ADMIN | WAREHOUSE_MANAGER | SALES_MANAGER | STAFF
// status: ACTIVE | INACTIVE
model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String
  role         String  @default("STAFF")
  avatar       String?
  phone        String?
  status       String  @default("ACTIVE")

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  inventoryTransactions InventoryTransaction[]
  purchaseOrdersCreated PurchaseOrder[]        @relation("CreatedPurchaseOrders")
  salesOrdersCreated    SalesOrder[]           @relation("CreatedSalesOrders")
  transfersRequested    StockTransfer[]        @relation("TransfersRequested")
  transfersSent         StockTransfer[]        @relation("TransfersSent")
  transfersReceived     StockTransfer[]        @relation("TransfersReceived")
  notifications         Notification[]
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

// status: ACTIVE | INACTIVE
model Warehouse {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  address     String?
  city        String?
  country     String?
  phone       String?
  email       String?
  managerName String?
  status      String  @default("ACTIVE")

  users                 User[]
  productInventories    ProductInventory[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  salesOrders           SalesOrder[]
  transfersOut          StockTransfer[] @relation("SourceWarehouse")
  transfersIn           StockTransfer[] @relation("DestinationWarehouse")
  lowStockAlerts        LowStockAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([status])
}

// status: ACTIVE | INACTIVE
model Supplier {
  id            String  @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  status        String  @default("ACTIVE")
  notes         String?

  products       Product[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// status: ACTIVE | INACTIVE
model Customer {
  id            String  @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  status        String  @default("ACTIVE")
  notes         String?

  salesOrders SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ============================================================
//  PRODUCTS & STOCK
// ============================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// status: ACTIVE | INACTIVE
model Product {
  id              String  @id @default(uuid())
  name            String
  sku             String  @unique
  barcode         String? @unique
  qrCode          String?
  description     String?
  uom             String  @default("pcs")
  costPrice       Decimal @default(0.0)
  sellingPrice    Decimal @default(0.0)
  discountPercent Float?
  minStockLevel   Int     @default(10)
  maxStockLevel   Int?
  imageUrl        String?
  status          String  @default("ACTIVE")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  inventories           ProductInventory[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrderItems    PurchaseOrderItem[]
  salesOrderItems       SalesOrderItem[]
  stockTransferItems    StockTransferItem[]
  lowStockAlerts        LowStockAlert[]
  forecasts             Forecast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([status])
}

model ProductInventory {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity         Int       @default(0)
  reservedQuantity Int       @default(0)
  locationBin      String?

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// type: STOCK_IN | STOCK_OUT | PURCHASE_RECEIVE | SALE | TRANSFER_OUT | TRANSFER_IN | ADJUSTMENT_INCREASE | ADJUSTMENT_DECREASE | RETURN
// referenceType: PURCHASE_ORDER | SALES_ORDER | STOCK_TRANSFER | MANUAL_ADJUSTMENT | INITIAL_COUNT | RETURN
model InventoryTransaction {
  id                String    @id @default(uuid())
  transactionNumber String    @unique
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  quantityBefore    Int
  quantityChange    Int
  quantityAfter     Int
  type              String
  referenceId       String?
  referenceType     String
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes             String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([transactionNumber])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId, referenceType])
}

// ============================================================
//  ORDERS
// ============================================================

// status: DRAFT | SUBMITTED | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
model PurchaseOrder {
  id                   String    @id @default(uuid())
  orderNumber          String    @unique
  supplierId           String
  supplier             Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId          String
  warehouse            Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  status               String    @default("DRAFT")
  totalAmount          Decimal   @default(0.0)
  notes                String?
  createdById          String?
  createdBy            User?     @relation("CreatedPurchaseOrders", fields: [createdById], references: [id], onDelete: SetNull)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  receivedQuantity Int           @default(0)
  unitCost         Decimal
  totalCost        Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

// status: DRAFT | CONFIRMED | PROCESSING | COMPLETED | CANCELLED
model SalesOrder {
  id           String    @id @default(uuid())
  orderNumber  String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  orderDate    DateTime  @default(now())
  deliveryDate DateTime?
  status       String    @default("DRAFT")
  subtotal     Decimal   @default(0.0)
  discount     Decimal   @default(0.0)
  tax          Decimal   @default(0.0)
  totalAmount  Decimal   @default(0.0)
  notes        String?
  createdById  String?
  createdBy    User?     @relation("CreatedSalesOrders", fields: [createdById], references: [id], onDelete: SetNull)

  items SalesOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal
  totalAmount  Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesOrderId])
  @@index([productId])
}

// ============================================================
//  STOCK TRANSFERS
// ============================================================

// status: DRAFT | PENDING_APPROVAL | APPROVED | IN_TRANSIT | RECEIVED | CANCELLED
model StockTransfer {
  id                     String    @id @default(uuid())
  transferNumber         String    @unique
  sourceWarehouseId      String
  sourceWarehouse        Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouseId String
  destinationWarehouse   Warehouse @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  status                 String    @default("DRAFT")

  requestedById String?
  requestedBy   User?   @relation("TransfersRequested", fields: [requestedById], references: [id], onDelete: SetNull)
  sentById      String?
  sentBy        User?   @relation("TransfersSent", fields: [sentById], references: [id], onDelete: SetNull)
  receivedById  String?
  receivedBy    User?   @relation("TransfersReceived", fields: [receivedById], references: [id], onDelete: SetNull)

  sentDate     DateTime?
  receivedDate DateTime?
  notes        String?

  items StockTransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transferNumber])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
}

model StockTransferItem {
  id                String        @id @default(uuid())
  stockTransferId   String
  stockTransfer     StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  requestedQuantity Int
  sentQuantity      Int           @default(0)
  receivedQuantity  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stockTransferId])
  @@index([productId])
}

// ============================================================
//  ALERTS & NOTIFICATIONS
// ============================================================

// status: NEW | VIEWED | RESOLVED
model LowStockAlert {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  currentQuantity  Int
  minStockLevel    Int
  shortageQuantity Int
  status           String    @default("NEW")
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([warehouseId])
  @@index([status])
}

// type: LOW_STOCK | OUT_OF_STOCK | PURCHASE_ORDER | SALES_ORDER | STOCK_TRANSFER | SYSTEM
model Notification {
  id        String  @id @default(uuid())
  title     String
  message   String
  type      String  @default("SYSTEM")
  link      String?
  read      Boolean @default(false)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// ============================================================
//  FORECASTING & AUDIT
// ============================================================

model Forecast {
  id                     String   @id @default(uuid())
  productId              String
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  calculatedAt           DateTime @default(now())
  dailyAvgSales          Decimal
  predictedDemand7d      Int
  predictedDemand30d     Int
  currentStock           Int
  estimatedDaysRemaining Int
  recommendedReorderQty  Int
  notes                  String?

  createdAt DateTime @default(now())

  @@index([productId])
}

model AuditLog {
  id           String  @id @default(uuid())
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?
  action       String
  resourceType String
  resourceId   String?
  description  String
  metadata     String?
  ipAddress    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}
